{
  "name": "kirarin-timeline",
  "version": "2.0.0",
  "private": true,
  "description": "星光Kirarin 活动时间轴 — a static fan timeline built with Eleventy.",
  "type": "module",
  "scripts": {
    "dev": "eleventy --serve",
    "build": "npm run clean && eleventy",
    "clean": "node -e \"require('node:fs').rmSync('_site', { recursive: true, force: true })\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run lint && npm run build"
  },
  "keywords": [
    "timeline",
    "virtual-youtuber",
    "kirarin",
    "eleventy"
  ],
  "author": "KIRA碳",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yandujun363/static-timeline-generator.git"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.8",
    "@11ty/eleventy-plugin-ejs": "^1.0.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10"
  }
}
