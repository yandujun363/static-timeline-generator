<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title><%= head.title %></title>
<meta name="description" content="<%= head.description %>" />
<meta name="author" content="<%= head.author %>" />
<meta name="color-scheme" content="light dark" />
<meta name="theme-color" content="#fff8f6" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#141018" media="(prefers-color-scheme: dark)" />

<link rel="icon" href="img/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="img/favicon.png" type="image/png" sizes="512x512" />
<link rel="apple-touch-icon" href="img/favicon.png" />
<link rel="stylesheet" href="css/main.css" />

<meta property="og:type" content="website" />
<meta property="og:locale" content="zh_CN" />
<meta property="og:site_name" content="<%= head.title %>" />
<meta property="og:title" content="<%= head.title %>" />
<meta property="og:description" content="<%= head.description %>" />
<meta property="og:image" content="img/og-image.png" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content="<%= head.title %>" />
<meta name="twitter:description" content="<%= head.description %>" />
<meta name="twitter:image" content="img/og-image.png" />

<script>
  (() => {
    const root = document.documentElement;
    const key = 'kirarin-theme';
    let stored = null;

    try {
      stored = localStorage.getItem(key);
    } catch {
      /* 隐私模式下 localStorage 可能不可用，回退到系统主题。 */
    }

    const prefersDark = window.matchMedia?.('(prefers-color-scheme: dark)').matches ?? false;
    const theme = stored === 'light' || stored === 'dark' ? stored : prefersDark ? 'dark' : 'light';

    root.dataset.theme = theme;
  })();
</script>
