<!DOCTYPE html>
<html lang="zh-CN" class="no-js">
  <head>
    <%- include('/head', { head: timeline.site }) %>
  </head>
  <body>
    <a class="skip-link" href="#timeline">跳到时间轴</a>
    <%- include('/sprite') %>

    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="#top" aria-label="星光Kirarin 活动时间轴首页">
          <span class="brand-mark" aria-hidden="true">
            <svg class="icon"><use href="#i-star" /></svg>
          </span>
          <span class="brand-text">
            <strong><%= timeline.profile.name %></strong>
            <small>活动时间轴</small>
          </span>
        </a>

        <nav class="site-nav" aria-label="主导航">
          <a href="#timeline">时间轴</a>
          <a href="#about">关于</a>
          <a href="#sources">来源</a>
        </nav>

        <button class="theme-toggle" id="theme-toggle" type="button" aria-label="切换深色模式">
          <svg class="icon theme-icon theme-icon--moon" aria-hidden="true"><use href="#i-moon" /></svg>
          <svg class="icon theme-icon theme-icon--sun" aria-hidden="true"><use href="#i-sun" /></svg>
        </button>
      </div>
    </header>

    <main id="top">
      <section class="hero">
        <div class="container hero-inner">
          <div class="hero-copy">
            <p class="eyebrow"><span aria-hidden="true">✦</span> FAN TIMELINE · 2024—2026</p>
            <h1>
              <span class="hero-name"><%= timeline.profile.name %></span>
              <span class="hero-subtitle">活动时间轴</span>
            </h1>
            <p class="hero-tagline"><%= timeline.profile.tagline %></p>
            <p class="hero-intro"><%= timeline.profile.intro %></p>

            <div class="hero-actions">
              <a
                class="button button--primary"
                href="<%= timeline.profile.links[0].href %>"
                target="_blank"
                rel="noreferrer noopener"
              >
                <svg class="icon" aria-hidden="true"><use href="#i-play" /></svg>
                前往 B 站
              </a>
              <a class="button button--ghost" href="#timeline">
                查看时间轴
                <svg class="icon" aria-hidden="true"><use href="#i-arrow-right" /></svg>
              </a>
            </div>

            <ul class="hero-stats" aria-label="关键数据">
              <% timeline.profile.stats.forEach(function (stat) { %>
              <li>
                <span class="stat-value"><%= stat.value %></span>
                <span class="stat-label"><%= stat.label %></span>
              </li>
              <% }); %>
            </ul>
          </div>

          <div class="hero-emblem" aria-hidden="true">
            <span class="orbit orbit--outer"></span>
            <span class="orbit orbit--inner"></span>
            <svg class="hero-star" viewBox="0 0 200 200" role="presentation">
              <defs>
                <linearGradient id="star-gradient" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0" stop-color="#fff6f8" />
                  <stop offset="0.55" stop-color="#f8b2bb" />
                  <stop offset="1" stop-color="#b78af0" />
                </linearGradient>
              </defs>
              <path
                d="M100 10 123.5 71.5 189 73 136.5 114 155.5 178 100 140 44.5 178 63.5 114 11 73 76.5 71.5Z"
                fill="url(#star-gradient)"
              />
            </svg>
            <span class="spark spark--1">✦</span>
            <span class="spark spark--2">✦</span>
            <span class="spark spark--3">✦</span>
          </div>
        </div>
      </section>

      <section class="timeline-section" id="timeline">
        <div class="container section-heading">
          <p class="section-kicker">TIMELINE</p>
          <h2>从出道到下一次生日回</h2>
          <p>
            按时间顺序记录直播、作品与里程碑。使用分类筛选或搜索快速定位；资料截至
            <time datetime="<%= timeline.lastUpdated %>"><%= timeline.lastUpdatedLabel %></time>。
          </p>
        </div>

        <div class="filter-bar">
          <div class="container filter-inner">
            <div class="filter-row">
              <div class="filter-group" role="group" aria-label="按分类筛选">
                <span class="filter-label">
                  <svg class="icon" aria-hidden="true"><use href="#i-filter" /></svg>
                  筛选
                </span>
                <div class="chips">
                  <button
                    class="chip is-active"
                    type="button"
                    data-filter="all"
                    aria-pressed="true"
                  >
                    全部
                    <span class="chip-count"><%= timeline.entries.length %></span>
                  </button>
                  <% timeline.filters.forEach(function (filter) { %>
                  <button
                    class="chip"
                    type="button"
                    data-filter="<%= filter.name %>"
                    aria-pressed="false"
                  >
                    <span class="chip-dot color-<%= filter.color %>" aria-hidden="true"></span>
                    <%= filter.name %>
                    <span class="chip-count"><%= filter.count %></span>
                  </button>
                  <% }); %>
                </div>
              </div>

              <label class="search-field">
                <svg class="icon" aria-hidden="true"><use href="#i-search" /></svg>
                <span class="visually-hidden">搜索时间轴</span>
                <input
                  id="timeline-search"
                  type="search"
                  placeholder="搜索事件、作品或关键词…"
                  autocomplete="off"
                  spellcheck="false"
                />
                <kbd aria-hidden="true">/</kbd>
              </label>
            </div>

            <div class="filter-status">
              <p id="result-count" role="status" aria-live="polite">
                共 <%= timeline.entries.length %> 条事件
              </p>
            </div>
          </div>
        </div>

        <div class="container timeline-wrap">
          <p class="no-js-note">
            分类筛选与搜索需要启用 JavaScript；当前会按时间顺序展示全部事件。
          </p>
          <div class="timeline">
            <% timeline.years.forEach(function (group) { %>
            <section class="year-group" data-year="<%= group.year %>">
              <h2 class="year-marker"><span><%= group.year %></span></h2>

              <% group.entries.forEach(function (entry) { %>
              <article
                id="<%= entry.id %>"
                class="timeline-entry is-<%= entry.side %><% if (entry.isUpcoming) { %> is-upcoming<% } %>"
                data-categories="<%= entry.categoriesString %>"
                data-search="<%= entry.searchText %>"
              >
                <div class="entry-card">
                  <div class="entry-meta">
                    <span class="entry-date">
                      <svg class="icon" aria-hidden="true"><use href="#i-clock" /></svg>
                      <time datetime="<%= entry.iso %>">
                        <%= entry.dateLabel %><% if (entry.timeLabel) { %> ·
                        <%= entry.timeLabel %><% } %>
                      </time>
                    </span>
                    <span class="entry-tags">
                      <% entry.categoryTags.forEach(function (tag) { %>
                      <span class="tag color-<%= tag.color %>"><%= tag.name %></span>
                      <% }); %> <% if (entry.isUpcoming) { %>
                      <span class="tag tag--upcoming">即将到来</span>
                      <% } %>
                    </span>
                  </div>

                  <h3 class="entry-title">
                    <a href="#<%= entry.id %>"><%= entry.title %></a>
                    <a
                      class="entry-anchor"
                      href="#<%= entry.id %>"
                      aria-label="「<%= entry.title %>」的锚点链接"
                    >
                      <svg class="icon" aria-hidden="true"><use href="#i-link" /></svg>
                    </a>
                  </h3>

                  <div class="entry-body">
                    <% if (utilities.isWrappedInParagraphTags(entry.body)) { %> <%- entry.body %>
                    <% } else { %>
                    <p><%- entry.body %></p>
                    <% } %>
                  </div>

                  <% if (entry.image) { %>
                  <figure class="entry-figure">
                    <% if (entry.image.link) { %>
                    <a
                      href="<%= entry.image.link %>"
                      target="_blank"
                      rel="noreferrer noopener"
                    >
                      <% } %>
                      <img
                        src="<%= entry.image.src %>"
                        alt="<%= entry.image.alt || '' %>"
                        loading="lazy"
                        decoding="async"
                      />
                      <% if (entry.image.link) { %>
                    </a>
                    <% } %> <% if (entry.image.caption) { %>
                    <figcaption><%- entry.image.caption %></figcaption>
                    <% } %>
                  </figure>
                  <% } %> <% if (entry.links && entry.links.length) { %>
                  <ul class="entry-links">
                    <% entry.links.forEach(function (link) { %>
                    <li>
                      <a href="<%= link.href %>" target="_blank" rel="noreferrer noopener">
                        <%= link.label %>
                        <svg class="icon" aria-hidden="true"><use href="#i-arrow-up-right" /></svg>
                      </a>
                    </li>
                    <% }); %>
                  </ul>
                  <% } %>
                </div>

                <div class="entry-node color-<%= entry.color %>" aria-hidden="true">
                  <svg class="icon"><use href="#i-<%= entry.icon %>" /></svg>
                </div>
              </article>
              <% }); %>
            </section>
            <% }); %>
          </div>

          <div class="empty-state" id="empty-state" hidden>
            <p class="empty-title">没有找到匹配的事件</p>
            <p>换一个关键词，或清除筛选后再试。</p>
            <button class="button button--ghost" type="button" id="clear-filters">
              清除筛选
            </button>
          </div>
        </div>
      </section>

      <section class="about-section" id="about">
        <div class="container">
          <div class="section-heading">
            <p class="section-kicker">ABOUT</p>
            <h2>关于星光Kirarin</h2>
            <p>
              一位「可以被他人强大愿望赋予任何身份」的星光妖精，正在把偶像这件事，做成一场持续三年的长线直播。
            </p>
          </div>

          <div class="about-grid">
            <article class="panel">
              <h3 class="panel-title">设定档案</h3>
              <dl class="facts">
                <% timeline.profile.facts.forEach(function (fact) { %>
                <div class="fact">
                  <dt><%= fact.label %></dt>
                  <dd><%= fact.value %></dd>
                </div>
                <% }); %>
              </dl>
            </article>

            <aside class="panel panel--tinted">
              <h3 class="panel-title">关于本站</h3>
              <p>
                这是一个粉丝向的非官方时间轴，用来归档星光Kirarin 的出道、舰队里程碑、生日回、周年与新衣装，以及那些值得被记住的作品和联动。
              </p>
              <p>
                内容依据公开资料整理，日期以 bilibili 投稿与萌娘百科记录为准；不确定的信息会在条目中保留原始措辞。
              </p>
              <p class="panel-note">
                最后更新：
                <time datetime="<%= timeline.lastUpdated %>"><%= timeline.lastUpdatedLabel %></time>
              </p>
              <a class="text-link" href="#sources">
                查看资料来源
                <svg class="icon" aria-hidden="true"><use href="#i-arrow-right" /></svg>
              </a>
            </aside>
          </div>
        </div>
      </section>

      <section class="sources-section" id="sources">
        <div class="container">
          <div class="section-heading">
            <p class="section-kicker">SOURCES</p>
            <h2>资料来源</h2>
            <p>时间轴中的日期与事件，优先采用可追溯的公开记录。</p>
          </div>

          <ol class="sources-grid">
            <% timeline.sources.forEach(function (source, index) { %>
            <li class="source-card">
              <span class="source-index"><%= String(index + 1).padStart(2, '0') %></span>
              <a href="<%= source.href %>" target="_blank" rel="noreferrer noopener">
                <strong><%= source.label %></strong>
                <span><%= source.note %></span>
              </a>
              <svg class="icon" aria-hidden="true"><use href="#i-arrow-up-right" /></svg>
            </li>
            <% }); %>
          </ol>

          <p class="disclaimer"><%= timeline.footerNote %></p>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <p class="footer-brand">
          <span class="brand-mark brand-mark--sm" aria-hidden="true">
            <svg class="icon"><use href="#i-star" /></svg>
          </span>
          <%= timeline.profile.name %> · 活动时间轴
        </p>
        <p class="footer-meta">
          © 2024—<%= new Date().getFullYear() %> KIRA碳 · 非官方粉丝站 · Built with
          <a href="https://www.11ty.dev/" target="_blank" rel="noreferrer noopener">Eleventy</a>
        </p>
      </div>
    </footer>

    <button class="to-top" id="to-top" type="button" aria-label="回到顶部">
      <svg class="icon" aria-hidden="true"><use href="#i-arrow-up" /></svg>
    </button>

    <script type="module" src="js/site-js.js"></script>
  </body>
</html>
